<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The app is online-only: every screen reads and writes Supabase. The
         debug/profile manifests declare this for the Flutter tool (hot reload,
         breakpoints); release builds do NOT inherit those, so without this line
         a release APK/AAB has no network at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The in-app updater (`features/updater`) installs the signed APK it
         downloads from the GitHub Release. Android 8+ refuses an APK install
         started by an app without this permission, so the "Install update"
         button would open the installer and be turned away. The owner still
         grants "install unknown apps" for Gymly the first time; the card says
         so before they tap. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- `open_filex` (the updater's handoff to the installer) declares storage
         and media read permissions for its general file-opening case. The
         updater only ever opens a file it wrote into the app's own temporary
         directory, which needs no permission at all, so the merged ones are
         removed: a gym app that asks to read the owner's photos is a lie the
         manifest would tell on Play. CI asserts their absence on the built
         release APK, because only a merged manifest can see this. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove"/>
    <application
        android:label="gymly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Phone dialer for `ContactLauncher.call` (`tel:` URLs). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- `https://wa.me/...` links for `ContactLauncher.openWhatsApp`. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
            <data android:host="wa.me"/>
        </intent>
        <!-- Direct `whatsapp:` scheme. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <!-- The WhatsApp app itself, so package visibility resolves. -->
        <package android:name="com.whatsapp"/>
    </queries>
</manifest>
